PORT=3000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
DLS_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user
SMTP_PASS=smtp-password
SMTP_FROM="DLS Arena <noreply@example.com>"
PUBLIC_URL=https://arena.example.com
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dlsarena?sslmode=require
PG_POOL_MAX=1

# Use a private bucket; app routes enforce access before streaming screenshots.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=dls-arena-private
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

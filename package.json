{
  "name": "dls26-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Independent DLS 26 community tournament and fixture website",
  "main": "server.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node --check server.js && node --check db.js && node --check storage.js && node --check scripts/migrate-sqlite.js && node --check public/app.js",

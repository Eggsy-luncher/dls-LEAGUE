    "test": "node test/smoke.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "better-sqlite3": "^13.1.1"
  }
}

PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Admin rights are granted only after this address completes email verification.
DLS_ADMIN_EMAIL=ossommordecai@gmail.com

# SMTP settings are required to send account-verification messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Set this to the public HTTPS address when deployed behind a domain or proxy.
PUBLIC_URL=http://localhost:3000

# Local development uses SQLite and ./data by default. Production requires DATABASE_URL.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# DATA_DIR=

# Production-only private S3-compatible object storage (for example Cloudflare R2).
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=dls-arena-private
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# PG_POOL_MAX=1
